# ==============================================================================
# UNYKORN.AI x BITGO ENTERPRISE x MMA.INC - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE UNYKORN API & ENGINE SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
NODE_ENV=production
DEBUG=false
UNYKORN_PORT=8443
UNYKORN_HOST=0.0.0.0
UNYKORN_BASE_URL=https://api.mma.unykorn.ai
SECRET_KEY=generate_strong_64_byte_hex_secret_key_here_for_jwt_and_csrf
ALLOWED_ORIGINS=https://command.mma.unykorn.ai,https://mma.inc

# ------------------------------------------------------------------------------
# 2. BITGO ENTERPRISE PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------
BITGO_ENV=prod
BITGO_ACCESS_TOKEN=your_production_bitgo_enterprise_api_token
BITGO_EXPRESS_URL=http://127.0.0.1:3080/api/v2
BITGO_ENTERPRISE_ID=your_bitgo_enterprise_id_here
BITGO_WEBHOOK_SECRET=your_bitgo_webhook_signature_verification_secret

# BitGo MPC Wallets (Multi-Sig Enterprise Vaults)
BITGO_TREASURY_WALLET_ID=your_bitgo_main_treasury_wallet_id
BITGO_PURSE_ESCROW_WALLET_ID=your_bitgo_purse_escrow_wallet_id
BITGO_RWA_GYM_WALLET_ID=your_bitgo_rwa_financing_wallet_id

# BitGo Prime / OTC Prediction & Hedging Desk
BITGO_PRIME_ACCOUNT_ID=your_bitgo_prime_account_id
BITGO_PRIME_API_KEY=your_bitgo_prime_api_key

# ------------------------------------------------------------------------------
# 3. ON-CHAIN & SMART CONTRACT CONFIGURATION (ETHEREUM MAINNET / L2)
# ------------------------------------------------------------------------------
NETWORK_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_ID=1
DEPLOYER_PRIVATE_KEY=0x_secure_deployer_hardware_key_or_kms_key

# Deployed Production Contract Addresses (Populated post-deployment)
CONTRACT_IDENTITY_REGISTRY=0x0000000000000000000000000000000000000000
CONTRACT_PURSE_SETTLEMENT=0x0000000000000000000000000000000000000000
CONTRACT_GYM_RWA_ESCROW=0x0000000000000000000000000000000000000000
CONTRACT_XP_PASSPORT=0x0000000000000000000000000000000000000000
CONTRACT_COMBAT_ORACLE=0x0000000000000000000000000000000000000000
CONTRACT_TRAIN_TO_EARN=0x0000000000000000000000000000000000000000

# Verified Settlement Asset Contracts (USD1, USDC, USDT, JPYC)
TOKEN_USD1_ADDRESS=0x0000000000000000000000000000000000000000 # World Liberty Financial USD1
TOKEN_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
TOKEN_USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
TOKEN_JPYC_ADDRESS=0x431D5dfF03120AFA4bDf332c61A6e1896eAA57f8

# ------------------------------------------------------------------------------
# 4. MULTI-JURISDICTION & ORACLE DATA FEEDS
# ------------------------------------------------------------------------------
ATHLETIC_COMMISSION_ORACLE_PUBLIC_KEY=0x_athletic_commission_signer_key
RINGSIDE_DATA_FEED_URL=https://live-telemetry.mma.inc/v1/oracle
RINGSIDE_FEED_API_KEY=your_secured_feed_api_key

# APAC Settlement Gateways
THAILAND_VASP_GATEWAY_URL=https://api.regulated-thai-vasp.co.th/v1
THAILAND_VASP_CLIENT_ID=your_thai_vasp_client_id
THAILAND_VASP_CLIENT_SECRET=your_thai_vasp_client_secret

JAPAN_JFSA_GATEWAY_URL=https://api.licensed-japan-epiesp.jp/v1
JAPAN_JFSA_API_KEY=your_japan_gateway_api_key

# ------------------------------------------------------------------------------
# 5. ENTERPRISE SECURITY, LOGGING & MONITORING
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://unykorn_prod:your_secure_db_pass@127.0.0.1:5432/unykorn_mma_prod
REDIS_URL=redis://127.0.0.1:6379/0
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project
LOG_LEVEL=INFO
